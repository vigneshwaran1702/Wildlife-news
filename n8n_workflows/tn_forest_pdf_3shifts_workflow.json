{
  "name": "TN Forest PDF 3-Shift Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * *"
            }
          ]
        }
      },
      "id": "trigger-shift1",
      "name": "Shift 1 Cron (5:00 PM Daily)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/pdf/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"title\": \"Shift 1 Day Bulletin (08:00 AM - 05:00 PM)\",\n  \"report_type\": \"Shift 1: Day Bulletin (8:00 AM - 5:00 PM)\"\n}",
        "options": {}
      },
      "id": "generate-shift1",
      "name": "Generate Shift 1 PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        200
      ]
    },
    {
      "parameters": {
        "url": "=http://localhost:8000{{ $json.download_url }}",
        "responseFormat": "file",
        "options": {}
      },
      "id": "download-shift1",
      "name": "Download Shift 1 PDF Binary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        640,
        200
      ]
    },
    {
      "parameters": {
        "fileName": "=/pdfs/n8n_shift1_day_{{ $now.format('yyyy-MM-dd') }}.pdf"
      },
      "id": "save-shift1",
      "name": "Save Shift 1 PDF to Disk",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        860,
        200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 21 * * *"
            }
          ]
        }
